{
  "name": "electron-app",
  "version": "1.0.7",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tio-dev71/ManagerVideoUpload.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "start:frontend": "npm run dev --prefix frontend",
    "pack": "electron-builder --dir",
    "dist": "npm run build --prefix frontend && electron-builder"
  },
  "build": {
    "appId": "com.topify.automation",
    "productName": "Topify Automation",
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "totp-generator": "^2.0.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
